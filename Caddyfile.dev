# OpenWook - Caddy Configuration
# Full-Stack Next.js 16 Application with PostgreSQL

{
    # Global options
    auto_https off
    admin off
}

# Development - HTTP only (port 80)
:80 {
    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 10MB
            roll_keep 10
        }
        format json
    }

    # Enable compression
    encode zstd gzip

    # Security headers for all responses
    header {
        # Security
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        
        # Remove server identification
        -Server
    }

    # API routes - CORS headers (aligns with next.config.ts)
    @api {
        path /api/*
    }
    
    handle @api {
        header {
            Access-Control-Allow-Origin "*"
            Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization"
            Access-Control-Max-Age "86400"
        }

        # Handle preflight requests
        @options method OPTIONS
        handle @options {
            respond "" 204
        }

        reverse_proxy localhost:3000 {
            # Health check
            health_uri /api/health
            health_interval 30s
            
            # Headers to pass to Next.js
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    # Static files - serve directly from public directory
    @static {
        path /images/* /fonts/* /favicon.ico /robots.txt /sitemap.xml
    }

    handle @static {
        root * /home/ubuntu/projects/openwook/public
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Next.js _next static assets (built JS/CSS chunks)
    @next_static {
        path /_next/*
    }

    handle @next_static {
        reverse_proxy localhost:3000
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Default - proxy all other requests to Next.js
    handle {
        reverse_proxy localhost:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}

            # Timeouts
            transport http {
                read_buffer 8192
                write_buffer 8192
                dial_timeout 30s
            }
        }
    }
}

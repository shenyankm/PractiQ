# Dockerfile.server builds from the repository root.
# Include only its COPY inputs; omit desktop files, tests, reports and local data.
**
!Dockerfile.server
!server/
server/**
!server/pyproject.toml
!server/uv.lock
!server/src/
!server/src/**

# Exclude generated Python files and local secrets even inside src.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.env
**/.env.*
**/*.pem
**/*.key

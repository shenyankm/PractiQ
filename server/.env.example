AI_SERVICE_TOKEN=replace-with-service-token
LANGSMITH_API_KEY=replace-with-langsmith-api-key
LANGGRAPH_CLOUD_LICENSE_KEY=replace-with-license-key
DATABASE_URI=postgres://user:password@postgres:5432/practiq
REDIS_URI=redis://redis:6379/0
LLM_PROVIDER=dashscope
LLM_API_KEY=replace-with-provider-api-key
LLM_TEXT_MODEL=replace-with-text-model
LLM_VISION_MODEL=

AI_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
AI_OSS_BUCKET=replace-with-oss-bucket
AI_OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
AI_OSS_ACCESS_KEY_SECRET=replace-with-oss-access-key-secret

# Agent Server / application capacity
N_JOBS_PER_WORKER=8
AI_GRAPH_MAX_CONCURRENCY=2
AI_OSS_CONCURRENCY=4

# Input and derived-artifact limits
AI_SOURCE_MAX_BYTES=26214400
AI_MAX_DOCUMENT_PAGES=100
AI_MAX_VISION_BYTES=52428800
AI_MAX_VISION_PAGE_PIXELS=25000000
AI_MAX_TOTAL_INPUT_CHARS=2000000

# External-call limits
AI_AGENT_MAX_TOKENS=16384
AI_AGENT_TIMEOUT_SECONDS=180
AI_OSS_TIMEOUT_SECONDS=30

# Existing Java answer/report concurrency and compatibility deadline
AI_AGENT_MAX_CONCURRENCY=4
# Local Agent Server: make server-dev (port 8090), Java AI_SERVICE_URL matches.

# Private AI service; use the same token as ../.env.local.
AI_SERVICE_TOKEN=replace-with-service-token
# Optional tracing; local langgraph dev needs no production license.
# LANGSMITH_API_KEY=replace-with-langsmith-api-key
# Standalone production only (not used for persistence by make server-dev):
# LANGGRAPH_CLOUD_LICENSE_KEY=replace-with-license-key
# DATABASE_URI=postgres://user:password@127.0.0.1:54322/practiq_agent
# REDIS_URI=redis://127.0.0.1:6379/1
LLM_PROVIDER=dashscope
LLM_API_KEY=replace-with-provider-api-key
LLM_TEXT_MODEL=replace-with-text-model
LLM_VISION_MODEL=
# Tested default; json_schema is an explicit opt-in for supported DashScope models.
AI_STRUCTURED_OUTPUT_METHOD=function_calling
# Qwen3.7 calls use enable_thinking=false for structured extraction/generation.

# Agent Server / application capacity
N_JOBS_PER_WORKER=8
AI_GRAPH_MAX_CONCURRENCY=2
AI_STORAGE_CONCURRENCY=4

# Input and derived-artifact limits
AI_SOURCE_MAX_BYTES=26214400
AI_MAX_DOCUMENT_PAGES=100
AI_MAX_VISION_BYTES=52428800
AI_MAX_VISION_PAGE_PIXELS=25000000
AI_MAX_TOTAL_INPUT_CHARS=2000000

# Model and storage operation limits
AI_AGENT_MAX_TOKENS=16384
AI_AGENT_TIMEOUT_SECONDS=180
AI_STORAGE_TIMEOUT_SECONDS=30

# Product answer/report concurrency and compatibility deadline
AI_AGENT_MAX_CONCURRENCY=4
# Local Agent Server: make server-dev (port 8090), product AI_SERVICE_URL matches.

# AI source and derived files; relative paths resolve from repository root.
AI_STORAGE_DIR=.local/ai

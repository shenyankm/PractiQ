FROM node:22-bookworm AS web
WORKDIR /app/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml /app/frontend/
COPY frontend/tsconfig.json frontend/vite.config.ts frontend/index.html /app/frontend/
COPY frontend/src /app/frontend/src
COPY frontend/public /app/frontend/public
RUN corepack enable && pnpm install --frozen-lockfile && pnpm build

FROM golang:1.26-bookworm AS go-build
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum* /app/backend/
RUN go mod download
COPY backend/cmd /app/backend/cmd
COPY backend/internal /app/backend/internal
COPY backend/db /app/backend/db
RUN go build -o /out/practiq-api ./cmd/practiq-api && go build -o /out/practiq-worker ./cmd/practiq-worker && go build -o /out/practiq-admin ./cmd/practiq-admin

FROM debian:bookworm-slim
WORKDIR /app/backend
COPY --from=go-build /out/practiq-api /usr/local/bin/practiq-api
COPY --from=go-build /out/practiq-worker /usr/local/bin/practiq-worker
COPY --from=go-build /out/practiq-admin /usr/local/bin/practiq-admin
COPY --from=web /app/frontend/dist /app/frontend/dist
COPY backend/db /app/backend/db
EXPOSE 3000
CMD ["/usr/local/bin/practiq-api"]

{
  "name": "@practiq/taro-client",
  "version": "0.1.0",
  "private": true,
  "description": "PractiQ WeChat Mini Program client",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev:weapp": "node --env-file-if-exists=../.env.local node_modules/@tarojs/cli/bin/taro build --type weapp --watch",
    "build:weapp": "node --env-file-if-exists=../.env.local node_modules/@tarojs/cli/bin/taro build --type weapp",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build:weapp"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-react": "^7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.24",
    "babel-preset-taro": "4.2.1",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "typescript": "~5.9.3",
    "webpack": "5.91.0"
  },
  "packageManager": "npm@11.16.0"
}

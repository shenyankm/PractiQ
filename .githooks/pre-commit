#!/usr/bin/env sh
set -eu

tmp_file="$(mktemp)"
trap 'rm -f "$tmp_file"' EXIT

git diff --cached --name-only --diff-filter=ACMR -z -- \
  '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' > "$tmp_file"

if [ ! -s "$tmp_file" ]; then
  exit 0
fi

echo "Running ESLint on staged files..."
xargs -0 pnpm exec eslint < "$tmp_file"

{
  "name": "openwook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && OPENWOOK_SKIP_DB_TESTS=1 pnpm test && pnpm build",
    "db:setup": "node --experimental-strip-types lib/db/setup.ts",
    "db:seed": "node --experimental-strip-types lib/db/seed.ts",
    "db:ensure": "node --experimental-strip-types lib/db/ensure-openwook.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "worker:imports": "tsx --conditions react-server lib/openwook/import-worker.ts",
    "start:prod": "next start --hostname ${OPENWOOK_HOST:-127.0.0.1} --port ${PORT:-3000}"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "@mastra/core": "^1.36.0",
    "@node-rs/bcrypt": "^1.10.7",
    "@opentelemetry/api": "^1.9.1",
    "@tailwindcss/postcss": "4.1.7",
    "@vercel/otel": "^2.1.2",
    "alipay-sdk": "^4.14.0",
    "bullmq": "^5.77.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "eslint-config-next": "15.6.0-canary.59",
    "ioredis": "^5.10.1",
    "jose": "^6.0.11",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.0",
    "next": "15.6.0-canary.59",
    "pino": "^10.3.1",
    "postcss": "^8.5.3",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "swr": "^2.3.3",
    "tailwindcss": "4.1.7",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@eslint/eslintrc": "^3.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.19",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.7"
  }
}

{
  "name": "openwook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "lint": "eslint",
    "test": "vitest run",
    "db:setup": "node --experimental-strip-types lib/db/setup.ts",
    "db:seed": "node --experimental-strip-types lib/db/seed.ts",
    "db:ensure": "node --experimental-strip-types lib/db/ensure-openwook.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "worker:imports": "tsx --conditions react-server lib/openwook/import-worker.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@mastra/core": "^1.36.0",
    "@tailwindcss/postcss": "4.1.7",
    "@types/node": "^22.15.18",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "alipay-sdk": "^4.14.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.77.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "eslint-config-next": "15.6.0-canary.59",
    "ioredis": "^5.10.1",
    "jose": "^6.0.11",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.0",
    "next": "15.6.0-canary.59",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.3",
    "postgres": "^3.4.5",
    "puppeteer": "^25.0.4",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "4.1.7",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.7"
  }
}

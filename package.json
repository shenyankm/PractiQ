{
  "name": "openwook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "vite preview --host 127.0.0.1 --port 3000",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "test": "vitest run",
    "test:go": "go test ./internal/... ./cmd/openwook-admin ./cmd/openwook-api ./cmd/openwook-worker",
    "test:ai": "python -m pytest ai/tests",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm test && pnpm test:go && pnpm test:ai && pnpm build",
    "api:dev": "go run ./cmd/openwook-api",
    "ai:dev": "python -m uvicorn openwook_ai.main:app --app-dir ai --host 127.0.0.1 --port 8001",
    "db:apply": "go run ./cmd/openwook-admin db apply",
    "db:ensure": "go run ./cmd/openwook-admin db ensure",
    "db:seed": "go run ./cmd/openwook-admin db seed",
    "worker:imports": "go run ./cmd/openwook-worker"
  },
  "dependencies": {
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "@paddle/paddle-js": "^1.6.4",
    "@tailwindcss/postcss": "4.1.7",
    "lucide-react": "^0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.18.1",
    "swr": "^2.3.3",
    "tailwindcss": "4.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.19",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.7"
  }
}

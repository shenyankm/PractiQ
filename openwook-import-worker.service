[Unit]
Description=OpenWook Import Worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/projects/openwook
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info
Environment=OTEL_SERVICE_NAME=openwook-worker
Environment=POSTGRES_POOL_MAX=4
EnvironmentFile=-/home/ubuntu/projects/openwook/.env.local
ExecStart=/usr/bin/env pnpm worker:imports
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

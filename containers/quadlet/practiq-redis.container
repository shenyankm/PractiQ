[Unit]
Description=PractiQ local Redis cache and queue backend

[Container]
Image=docker.io/library/redis:7-alpine
ContainerName=practiq-redis
Network=practiq.network
NetworkAlias=practiq-redis
PublishPort=127.0.0.1:6379:6379
Volume=practiq-redis.volume:/data:Z
Exec=redis-server --appendonly yes --save 60 1000 --maxmemory-policy noeviction
HealthCmd=redis-cli ping
HealthInterval=10s
HealthRetries=6
HealthStartupInterval=2s
HealthStartupRetries=30
Pull=missing

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target

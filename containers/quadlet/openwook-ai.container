[Unit]
Description=OpenWook internal AI service

[Container]
Image=localhost/openwook-ai:latest
ContainerName=openwook-ai
Network=openwook.network
NetworkAlias=openwook-ai
PublishPort=127.0.0.1:8001:8001
Environment=AI_POSTGRES_URL
Environment=AI_SERVICE_TOKEN
Environment=IMPORT_SOURCE_MAX_BYTES
Environment=MINERU_API_URL
Environment=MINERU_BACKEND
Environment=MINERU_LANGUAGE
Environment=MINERU_TIMEOUT_SECONDS
Environment=MINERU_MAX_RESPONSE_BYTES
Environment=OPENAI_BASE_URL
Environment=OPENAI_API_KEY
Environment=OPENAI_MODEL
Environment=AI_AGENT_TIMEOUT_SECONDS
Environment=AI_AGENT_MAX_TOKENS
Environment=AI_AGENT_MAX_RESPONSE_BYTES
HealthCmd=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/internal/health/live').read()"
Pull=never

[Service]
EnvironmentFile=-%h/.config/openwook/openwook-stack.env
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target

[Unit]
Description=OpenWook internal AI service

[Container]
Image=localhost/openwook-ai:latest
ContainerName=openwook-ai
Network=openwook.network
NetworkAlias=openwook-ai
PublishPort=127.0.0.1:8001:8001
Environment=AI_SERVICE_TOKEN
HealthCmd=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/internal/health/live').read()"
Pull=never

[Service]
EnvironmentFile=-%h/.config/openwook/openwook-stack.env
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target

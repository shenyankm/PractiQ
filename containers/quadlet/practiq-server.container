[Unit]
Description=PractiQ unified server (API + AI)

[Container]
Image=localhost/practiq-server:latest
ContainerName=practiq-server
Network=practiq.network
NetworkAlias=practiq-server
PublishPort=127.0.0.1:3000:3000
Environment=POSTGRES_URL=postgres://practiq:practiq@practiq-postgres:5432/practiq_app
Environment=REDIS_URL=redis://practiq-redis:6379
Environment=AUTH_SECRET
Environment=PRACTIQ_HOST=0.0.0.0
Environment=PORT=3000
Environment=APP_ORIGIN=http://127.0.0.1:3000
Environment=REVENUECAT_PROJECT_ID
Environment=REVENUECAT_SECRET_API_KEY
Environment=REVENUECAT_PRO_ENTITLEMENT_ID
Environment=REVENUECAT_ORGANIZATION_ENTITLEMENT_ID
Environment=REVENUECAT_WEBHOOK_AUTHORIZATION
Environment=LLM_KEY_ENCRYPTION_SECRET
Environment=AI_AGENT_TIMEOUT_SECONDS
Environment=AI_AGENT_MAX_TOKENS
Environment=AI_MAX_OCR_PAGES
Environment=IMPORT_SOURCE_MAX_BYTES
Environment=AI_APPLY_MIN_CONFIDENCE
HealthCmd=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:3000/api/health/live').read()"
Pull=never

[Service]
EnvironmentFile=-%h/.config/practiq/practiq-stack.env
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target

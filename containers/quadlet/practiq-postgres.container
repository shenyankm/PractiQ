[Unit]
Description=PractiQ local PostgreSQL database

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=practiq-postgres
Network=practiq.network
NetworkAlias=practiq-postgres
PublishPort=127.0.0.1:54322:5432
Volume=practiq-postgres.volume:/var/lib/postgresql/data:Z
Environment=POSTGRES_DB=practiq_app
Environment=POSTGRES_USER=practiq
Environment=POSTGRES_PASSWORD=practiq
Environment=PGDATA=/var/lib/postgresql/data/pgdata
HealthCmd=pg_isready -U practiq -d practiq_app
HealthInterval=10s
HealthRetries=6
HealthStartupInterval=2s
HealthStartupRetries=30
Pull=missing

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target

[Unit]
Description=PractiQ API and static frontend server

[Container]
Image=localhost/practiq-api:latest
ContainerName=practiq-api
Network=practiq.network
NetworkAlias=practiq-api
PublishPort=127.0.0.1:3000:3000
Environment=POSTGRES_URL=postgres://practiq:practiq@practiq-postgres:5432/practiq_app
Environment=REDIS_URL=redis://practiq-redis:6379
Environment=AI_SERVICE_URL=http://practiq-ai:8001
Environment=AI_SERVICE_TOKEN
Environment=AI_SERVICE_TIMEOUT
Environment=AUTH_SECRET
Environment=PRACTIQ_HOST=0.0.0.0
Environment=PORT=3000
Environment=APP_ORIGIN=http://127.0.0.1:3000
Pull=never

[Service]
EnvironmentFile=-%h/.config/practiq/practiq-stack.env
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target

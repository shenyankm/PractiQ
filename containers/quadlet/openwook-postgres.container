[Unit]
Description=OpenWook local PostgreSQL database

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=openwook-postgres
Network=openwook.network
NetworkAlias=openwook-postgres
PublishPort=127.0.0.1:54322:5432
Volume=openwook-postgres.volume:/var/lib/postgresql/data:Z
Environment=POSTGRES_DB=openwook_app
Environment=POSTGRES_USER=openwook
Environment=POSTGRES_PASSWORD=openwook
Environment=PGDATA=/var/lib/postgresql/data/pgdata
HealthCmd=pg_isready -U openwook -d openwook_app
HealthInterval=10s
HealthRetries=6
HealthStartupInterval=2s
HealthStartupRetries=30
Pull=missing

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target

# ================================================
# OpenWook .gitignore
# OpenWook split-stack app
# ================================================

# -----------------------------------------------
# Dependencies
# -----------------------------------------------
/node_modules/
/frontend/node_modules/
/.pnp
.pnp.*

# Package manager caches / metadata
/.npm/
/.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# -----------------------------------------------
# Vite / Build Output
# -----------------------------------------------
/out/
/build/
/dist/
/frontend/dist/
/.turbo/

# -----------------------------------------------
# Python
# -----------------------------------------------
__pycache__/
*.py[cod]
# -----------------------------------------------
# Testing / Coverage / Reports
# -----------------------------------------------
/coverage/
/test-results/
/frontend/test-results/
/playwright-report/
/frontend/playwright-report/
/blob-report/
/reports/
*.lcov

# -----------------------------------------------
# Environment Variables
# -----------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# -----------------------------------------------
# OS Generated Files
# -----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
*.pem

# -----------------------------------------------
# Debug / Logs
# -----------------------------------------------
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# -----------------------------------------------
# TypeScript
# -----------------------------------------------
*.tsbuildinfo

# -----------------------------------------------
# IDE / Editor
# -----------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# -----------------------------------------------
# Vercel / Deployment
# -----------------------------------------------
.vercel/
.netlify/

# -----------------------------------------------
# Local Agent / Tool State
# -----------------------------------------------
.omx/
/.codegraph/
.worktrees/

# Project-local installed agent skills
/.agents/skills/paddle-*/
/.pi/skills/paddle-*
/.claude/skills/paddle-*
/.qwen/skills/paddle-*
/.qoder/skills/paddle-*
/skills-lock.json

# -----------------------------------------------
# SSL / Certificates
# -----------------------------------------------
*.key
*.crt
*.csr
*.der
*.p12
*.pfx

# -----------------------------------------------
# Database
# -----------------------------------------------
pgdata/
postgres_data/
*.dump
*.sql.gz
*.backup
*.sqlite
*.sqlite3
*.db
*.db-journal

# -----------------------------------------------
# Temporary Files / Local Uploads
# -----------------------------------------------
*.tmp
*.temp
*.cache
.cache/
*.bak
*.orig
uploads/
tmp/
temp/

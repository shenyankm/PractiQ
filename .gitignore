# ================================================
# PractiQ .gitignore
# PractiQ AI document import
# ================================================

# -----------------------------------------------
# Dependencies
# -----------------------------------------------
node_modules/
/.pnp
.pnp.*

# Package manager caches / metadata
/.npm/
/.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# -----------------------------------------------
# Build Output
# -----------------------------------------------
/out/
/build/
/dist/
/.turbo/

# Web / Python product build
/web/dist/
/web/test-results/
/backend/dist/
.local/

# -----------------------------------------------
# Python
# -----------------------------------------------
__pycache__/
*.py[cod]
.venv/
# -----------------------------------------------
# Testing / Coverage / Reports
# -----------------------------------------------
/coverage/
.coverage
/test-results/
/blob-report/
/reports/
*.lcov

# -----------------------------------------------
# Environment Variables
# -----------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# -----------------------------------------------
# OS Generated Files
# -----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
*.pem

# -----------------------------------------------
# Debug / Logs
# -----------------------------------------------
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# -----------------------------------------------
# TypeScript
# -----------------------------------------------
*.tsbuildinfo

# -----------------------------------------------
# IDE / Editor
# -----------------------------------------------
.classpath
.project
.settings/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# -----------------------------------------------
# Vercel / Deployment
# -----------------------------------------------
.vercel/
.netlify/

# -----------------------------------------------
# Local Agent / Tool State
# -----------------------------------------------
.opencode/*
!.opencode/opencode.json
.omx/
/.codegraph/
.pi-lens/
.worktrees/

# Project-local installed agent skills
/.agents/skills/paddle-*/
/.agents/skills/heroui-*/
/.pi/skills/paddle-*
/.claude/skills/paddle-*
/.qwen/skills/paddle-*
/.qoder/skills/paddle-*
/skills-lock.json

# -----------------------------------------------
# SSL / Certificates
# -----------------------------------------------
*.key
*.crt
*.csr
*.der
*.p12
*.pfx

# -----------------------------------------------
# Database
# -----------------------------------------------
pgdata/
postgres_data/
*.dump
*.sql.gz
*.backup
*.sqlite
*.sqlite3
*.db
*.db-journal

# -----------------------------------------------
# Temporary Files / Local Uploads
# -----------------------------------------------
*.tmp
*.temp
*.cache
.cache/
*.bak
*.orig
uploads/
tmp/
temp/

# Migrated AI development/build state (fixtures and historical reports are versioned)
.pytest_cache/
.ruff_cache/
.langgraph_api/
*.egg-info/
/server/**/dist/
/server/reports/checks/
/server/reports/evaluations/*/
/server/reports/reviews/
/server/**/.codex
/server/**/.qoder

# Local agent workspace data
.workbuddy/

# Server build and diagnostic output
/server/**/build/
.mypy_cache/
.pyright/
.coverage.*
coverage.xml
htmlcov/

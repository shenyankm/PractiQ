# Private checkout-only environment; never load this into the AI service.
# Copy to .env.payments with mode 0600. Use a separate checkout interpreter.
# Same dedicated PostgreSQL database; no AI/LLM/RabbitMQ credentials here.
DATABASE_URI=postgresql://USER:PASSWORD@127.0.0.1:5432/practiq
# Optional absolute path to the built Web assets:
# AI_WEB_DIR=/absolute/path/to/web/dist

# Optional independent Vibe Pay checkout; never needed by AI imports or offline practice.
# Start payment_webapp separately on loopback :8091 behind its own HTTPS entry point.
# For direct CLI/server execution, export TZ=Asia/Shanghai before starting Python.
# Set all values explicitly; no default merchant, price or live environment.
# PAYMENT_ENVIRONMENT=sandbox
# PAYMENT_APP_ID=<merchant application ID>
# PAYMENT_SELLER_ID=<merchant seller ID>
# Optional verified Alipay seller login account, used only when seller_id is absent:
# PAYMENT_SELLER_EMAIL=merchant@example.com
# PAYMENT_PRIVATE_KEY=<PKCS1 RSA private key, PEM or base64; literal \n supported>
# PAYMENT_ALIPAY_PUBLIC_KEY=<Alipay public key, PEM or base64>
# PAYMENT_NOTIFY_URL=https://checkout.example/api/payments/notify
# PAYMENT_RETURN_URL=https://checkout.example/purchase
# Only a deployed payment schema-1 offline upgrade needs its original PAYMENT_CARD_KEY.
# New checkout uses no card keys; see server/docs/payments.md.

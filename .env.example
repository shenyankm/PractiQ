# Core database/cache
POSTGRES_URL=postgres://practiq:practiq@localhost:54322/practiq_app
POSTGRES_POOL_MAX=8
POSTGRES_IDLE_TIMEOUT_SECONDS=30
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=practiq

# App host/origin
PRACTIQ_HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://127.0.0.1:3000

# Auth/session
# Required in every environment. Set an unpredictable value in .env.local.
AUTH_SECRET=
SESSION_TTL_MS=604800000
USER_CACHE_TTL_SECONDS=60
# Password for the `admin` user created by `make db-seed`. Defaults to the
# local dev value; set it explicitly on any shared environment.
SEED_ADMIN_PASSWORD=

# Registration email verification (SMTP). Leave SMTP_HOST empty in local dev
# to log verification codes instead of sending mail (never do this in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Google sign-in. Leave GOOGLE_CLIENT_ID empty to disable the Google routes.
# GOOGLE_MOBILE_CLIENT_IDS is a comma-separated list of additional accepted
# audiences (Expo/Android/iOS client IDs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MOBILE_CLIENT_IDS=

# Object storage
OBJECT_STORAGE_MOUNT_DIR=/lhcos-data
OSS_PUBLIC_BASE_URL=
OSS_URL_PREFIX=oss://practiq
IMPORT_SOURCE_MAX_BYTES=26214400

# AI service + providers
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT=5m
AI_APPLY_MIN_CONFIDENCE=0.7
DASHSCOPE_API_KEY=
AI_TEXT_MODEL=qwen-max
AI_VL_MODEL=qwen-vl-max
AI_AGENT_TIMEOUT_SECONDS=180
AI_AGENT_MAX_TOKENS=16384
AI_MAX_OCR_PAGES=1000

# Observability / caching
ANALYTICS_CACHE_TTL_SECONDS=30
LEADERBOARD_CACHE_TTL_SECONDS=60

# Private AI import service; clients must send this Bearer token.
AI_SERVICE_TOKEN=replace-with-service-token
# Local evaluation/observability only; no remote LangSmith traces.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# Local SQLite directory; use an absolute persistent directory in deployments.
AI_DATABASE_DIR=.local/database
# Required for LLM_PROVIDER=openai; optional override for provider presets.
# LLM_BASE_URL=https://api.example.com/v1
LLM_PROVIDER=dashscope
LLM_API_KEY=replace-with-provider-api-key
# Required single model for parsing and grading; must support text and image inputs.
LLM_MODEL=replace-with-multimodal-model
# Tested default; json_schema is an explicit opt-in for supported DashScope models.
AI_STRUCTURED_OUTPUT_METHOD=function_calling
# Qwen3.7 calls use enable_thinking=false for structured extraction.

# Single-process application capacity
N_JOBS_PER_WORKER=8
AI_GRAPH_MAX_CONCURRENCY=2
AI_STORAGE_CONCURRENCY=4
# Single-process SQLite runtime; values other than 1 are rejected.
AI_DEPLOYMENT_WORKERS=1
AI_PROVIDER_CONCURRENCY=16
AI_PROVIDER_RPM=120
AI_UPLOAD_CONCURRENCY=4
# Total time allowed to receive a binary upload body.
AI_UPLOAD_TIMEOUT_SECONDS=120
AI_MAX_BUSY_THREADS=300
AI_MAINTENANCE_MODE=false

# Input and derived-artifact limits
AI_SOURCE_MAX_BYTES=26214400
AI_MAX_DOCUMENT_PAGES=100
AI_MAX_VISION_BYTES=52428800
AI_MAX_VISION_PAGE_PIXELS=25000000
AI_MAX_TOTAL_INPUT_CHARS=2000000

# Model and storage operation limits
AI_AGENT_MAX_TOKENS=16384
AI_AGENT_TIMEOUT_SECONDS=180
AI_STORAGE_TIMEOUT_SECONDS=30
# Preallocated per-unit call slots; unused slots are deliberately not returned.
AI_TASK_MAX_MODEL_CALLS=400
AI_RUN_TIMEOUT_SECONDS=1800
AI_MODEL_MAX_INPUT_CHARS=64000

# Local AI source and derived files; relative paths resolve from server/.
# The historical directory name is retained to keep existing files accessible.
AI_STORAGE_DIR=.local/ai-oss

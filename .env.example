# Core database/cache
DATABASE_URL=postgres://openwook:openwook@localhost:5432/openwook
POSTGRES_URL=postgres://openwook:openwook@localhost:5432/openwook
POSTGRES_POOL_MAX=8
POSTGRES_IDLE_TIMEOUT_SECONDS=30
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=openwook

# Auth/session
AUTH_SECRET=replace-with-random-32-byte-secret
SESSION_TTL_MS=604800000
SESSION_RENEW_WINDOW_MS=21600000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Object storage
OBJECT_STORAGE_MOUNT_DIR=/lhcos-data
OSS_PUBLIC_BASE_URL=
OSS_URL_PREFIX=oss://openwook
AVATAR_MAX_BYTES=5242880
IMPORT_SOURCE_MAX_BYTES=26214400

# AI providers
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
MASTRA_MODEL=
MASTRA_TEMPERATURE=
MASTRA_MAX_TOKENS=
AI_CACHE_TTL_SECONDS=86400
AI_APPLY_MIN_CONFIDENCE=0.7

# Import queue
IMPORT_WORKER_CONCURRENCY=2
IMPORT_QUEUE_ATTEMPTS=3
IMPORT_QUEUE_BACKOFF_MS=5000
IMPORT_QUEUE_COMPLETE_TTL_SECONDS=86400
IMPORT_QUEUE_COMPLETE_COUNT=1000
IMPORT_QUEUE_FAIL_TTL_SECONDS=604800
IMPORT_QUEUE_FAIL_COUNT=1000
IMPORT_JOB_LOCK_TTL_MS=1800000

# Observability
LOG_LEVEL=info
SLOW_QUERY_MS=500
HEALTH_CHECK_TIMEOUT_MS=1500
METRICS_TOKEN=replace-with-metrics-scrape-token
OTEL_SERVICE_NAME=openwook-web
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Performance guardrails
OPENWOOK_SHORT_CACHE_TTL_SECONDS=60
OPENWOOK_REFERENCE_CACHE_TTL_SECONDS=3600
PRACTICE_MAX_QUESTIONS=500
PRACTICE_PROGRESS_FULL_LIMIT=120
PRACTICE_PROGRESS_WINDOW_RADIUS=30

# Core database/cache
POSTGRES_URL=postgres://practiq:practiq@localhost:54322/practiq_app
POSTGRES_POOL_MAX=8
POSTGRES_IDLE_TIMEOUT_SECONDS=30
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=practiq

# App host/origin
PRACTIQ_HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://127.0.0.1:3000

# Auth/session
# Required in every environment. Set an unpredictable value in .env.local.
AUTH_SECRET=
ACCESS_TOKEN_TTL_MS=600000
REFRESH_TOKEN_TTL_MS=2592000000
SESSION_ABSOLUTE_TTL_MS=7776000000
USER_CACHE_TTL_SECONDS=60
# Password for the `admin` user created by `make db-seed`. Defaults to the
# local dev value; set it explicitly on any shared environment.
SEED_ADMIN_PASSWORD=

# Registration email verification (SMTP). Leave SMTP_HOST empty in local dev
# to log verification codes instead of sending mail (never do this in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Google sign-in. Leave GOOGLE_CLIENT_ID empty to disable the Google routes.
# GOOGLE_MOBILE_CLIENT_IDS is a comma-separated list of additional accepted
# audiences (Expo/Android/iOS client IDs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MOBILE_CLIENT_IDS=

# Object storage
OBJECT_STORAGE_MOUNT_DIR=/lhcos-data
OSS_PUBLIC_BASE_URL=
OSS_URL_PREFIX=oss://practiq
IMPORT_SOURCE_MAX_BYTES=26214400

# RevenueCat. The entitlement ID is the v2 resource ID (entl...), while the
# mobile entitlement lookup keys remain "pro" and "organization". The server
# organization entitlement defaults to "organization" when left empty.
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PRO_ENTITLEMENT_ID=
REVENUECAT_ORGANIZATION_ENTITLEMENT_ID=organization
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Per-user AI providers (LangGraph, called in-process by the unified server).
# Supported providers: DashScope, DeepSeek, Moonshot. DeepSeek is text-only.
# Required encryption key; provider keys and model names are supplied by users with effective Pro-or-higher membership.
LLM_KEY_ENCRYPTION_SECRET=
AI_APPLY_MIN_CONFIDENCE=0.7
AI_AGENT_TIMEOUT_SECONDS=180
AI_AGENT_MAX_TOKENS=16384
AI_AGENT_MAX_CONCURRENCY=4
AI_MAX_OCR_PAGES=1000
AI_MAX_VISION_BYTES=52428800
AI_MAX_VISION_PAGE_PIXELS=25000000

# Observability / caching
ANALYTICS_CACHE_TTL_SECONDS=30
LEADERBOARD_CACHE_TTL_SECONDS=60

# Independent AI service and Web importer; model credentials stay server-side.
# Copy this template to .env for your personal AI service setup.
# Personal service access token shared by the Web importer and App grading.
# Use visible ASCII characters without spaces; surrounding whitespace is trimmed.
AI_SERVICE_TOKEN=replace-with-service-token

# Tencent asynchronous document parsing; credentials remain on the service.
# Enable SubmitMultimodalDocParseJob and DescribeMultimodalDocParseJob in Tencent Cloud.
AI_TENCENT_SECRET_ID=replace-with-tencent-secret-id
AI_TENCENT_SECRET_KEY=replace-with-tencent-secret-key
# Per-job ceiling. Local Base64 is capped at 8 MiB; COS URL mode also applies
# source-type caps: PDF/Word/PPT 150 MiB, Excel/TXT/Markdown 10 MiB, images 30 MiB.
# The deployment upload/page/character limits still apply. Larger inputs split
# before paid submission; oversized Office splitting needs the deployed converter.
AI_TENCENT_INPUT_MAX_BYTES=157286400
# Advanced opt-in: all submitted sources use a private COS bucket when enabled.
# Local files and result archives remain authoritative in either mode.
AI_TENCENT_COS_ENABLED=false
AI_TENCENT_COS_BUCKET=
AI_TENCENT_COS_REGION=

# Model for question structuring and grading.
LLM_PROVIDER=dashscope
LLM_API_KEY=replace-with-provider-api-key
LLM_MODEL=replace-with-structured-output-model
# AI_READ_ONLY=1 allows authenticated source uploads and existing results without models.
# Opt in to independent source review and at most one repair/recheck per unit.
# Additional calls consume AI_TASK_MAX_MODEL_CALLS; no automatic budget increase.
AI_IMPORT_REVIEW=false
# Required for LLM_PROVIDER=openai; optional override for provider presets.
# LLM_BASE_URL=https://api.example.com/v1
# The configured endpoint must support Responses API; transport is fixed in code.

# Dedicated PostgreSQL database; initialize explicitly with make init-db.
# Keep credentials server-side. Remote deployments should require TLS (sslmode=verify-full).
DATABASE_URI=postgresql://practiq:replace-with-database-password@127.0.0.1:5432/practiq
# Dedicated RabbitMQ vhost; credentials remain server-side. URL-encode credentials/vhost.
# Non-loopback broker hosts require amqps:// with certificate verification.
RABBITMQ_URI=amqp://practiq:replace-with-broker-password@127.0.0.1:5672/practiq
# Compose bootstraps a separate administrator; create a restricted practiq service user.
# RABBITMQ_ADMIN_USER=replace-with-administrator-name
# RABBITMQ_ADMIN_PASSWORD=replace-with-administrator-password
# Local source/artifact storage; relative paths resolve from server/.
# Use an absolute persistent directory in deployments.
# Keep the historical directory name so existing files remain accessible.
AI_STORAGE_DIR=.local/ai-oss

# Optional deployed LibreOffice. Configure both values; never discover system paths.
# AI_OFFICE_EXECUTABLE=/absolute/deployment/LibreOffice/program/soffice
# AI_OFFICE_VERSION=LibreOffice <exact deployed version and build>
# Optional built Web frontend; missing assets do not prevent API startup.
# AI_WEB_DIR=/absolute/deployment/web/dist

# Keep remote LangSmith tracing disabled.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Concurrency, limits, timeouts and structured output use config.py defaults.
# Optional overrides: server/src/practiq_ai/config.py; see server/docs/operations.md.
# Startup requires 9 * AI_SOURCE_MAX_BYTES + 65536 + AI_MAX_VISION_BYTES <= 402653184.

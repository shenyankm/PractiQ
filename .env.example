# Core database/cache
POSTGRES_URL=postgres://openwook:openwook@localhost:54322/openwook_app
POSTGRES_POOL_MAX=8
POSTGRES_IDLE_TIMEOUT_SECONDS=30
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
AI_POSTGRES_URL=
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=openwook

# App host/origin
OPENWOOK_HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://127.0.0.1:3000

# Auth/session
AUTH_SECRET=replace-with-random-32-byte-secret
SESSION_TTL_MS=604800000
SESSION_RENEW_WINDOW_MS=21600000
USER_CACHE_TTL_SECONDS=60

# Paddle billing
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PLUS_PRICE_ID=
PADDLE_PLUS_LABEL=Plus
PADDLE_PLUS_AMOUNT_CENTS=1900
PADDLE_PLUS_CURRENCY_CODE=USD
PADDLE_PLUS_INTERVAL=month
PADDLE_PLUS_TRIAL_DAYS=7
PADDLE_ENTERPRISE_PRICE_ID=
PADDLE_ENTERPRISE_LABEL=Enterprise
PADDLE_ENTERPRISE_AMOUNT_CENTS=9900
PADDLE_ENTERPRISE_CURRENCY_CODE=USD
PADDLE_ENTERPRISE_INTERVAL=year
PADDLE_ENTERPRISE_TRIAL_DAYS=14

# Object storage
OBJECT_STORAGE_MOUNT_DIR=/lhcos-data
OSS_PUBLIC_BASE_URL=
OSS_URL_PREFIX=oss://openwook
AVATAR_MAX_BYTES=5242880
IMPORT_SOURCE_MAX_BYTES=26214400

# AI service + providers
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=dev-ai-token
AI_APPLY_MIN_CONFIDENCE=0.7
MINERU_API_URL=
MINERU_BACKEND=pipeline
MINERU_LANGUAGE=ch
MINERU_TIMEOUT_SECONDS=600
MINERU_MAX_RESPONSE_BYTES=5242880
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_AGENT_TIMEOUT_SECONDS=180
AI_AGENT_MAX_TOKENS=16384
AI_AGENT_MAX_RESPONSE_BYTES=5242880

# Import queue / worker
IMPORT_WORKER_CONCURRENCY=2
IMPORT_QUEUE_NAME=
IMPORT_QUEUE_ATTEMPTS=3
IMPORT_QUEUE_BACKOFF_MS=5000
IMPORT_QUEUE_COMPLETE_TTL_SECONDS=86400
IMPORT_QUEUE_COMPLETE_COUNT=1000
IMPORT_QUEUE_FAIL_TTL_SECONDS=604800
IMPORT_QUEUE_FAIL_COUNT=1000
IMPORT_JOB_LOCK_TTL_MS=1800000
IMPORT_QUEUE_POLL_TIMEOUT_MS=2500

# Observability / caching
LOG_LEVEL=info
SLOW_QUERY_MS=500
HEALTH_CHECK_TIMEOUT_MS=1500
OPENWOOK_SHORT_CACHE_TTL_SECONDS=60
OPENWOOK_REFERENCE_CACHE_TTL_SECONDS=3600
ANALYTICS_CACHE_TTL_SECONDS=30
LEADERBOARD_CACHE_TTL_SECONDS=60

# Practice guardrails
PRACTICE_MAX_QUESTIONS=500
PRACTICE_PROGRESS_FULL_LIMIT=120
PRACTICE_PROGRESS_WINDOW_RADIUS=30

# OpenWook - Production Caddy Configuration
# Domains:
# - openwook.cloud      -> canonical HTTPS site
# - www.openwook.cloud  -> permanent redirect to openwook.cloud
#
# DNS observed:
# - openwook.cloud      A 122.51.255.108
# - www.openwook.cloud  A 122.51.255.108
{
	email admin@openwook.cloud
}

(openwook_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		-X-Powered-By
		-Server
	}
}

(openwook_proxy_headers) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
}

(openwook_next_upstreams) {
	reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 127.0.0.1:3002 127.0.0.1:3003 {
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 30s
		max_fails 3
		health_uri /api/health/ready
		health_interval 10s
		health_timeout 2s
		health_status 200
		import openwook_proxy_headers
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
			read_timeout 300s
			write_timeout 300s
		}
	}
}

www.openwook.cloud {
	import openwook_security_headers
	encode zstd gzip
	redir https://openwook.cloud{uri} permanent
}

openwook.cloud {
	import openwook_security_headers

	log {
		output file /var/log/caddy/openwook-access.log {
			roll_size 10MB
			roll_keep 30
			roll_keep_for 720h
		}
		format json {
			time_format iso8601
		}
	}

	encode zstd gzip

	@api {
		path /api/*
	}

	handle @api {
		header {
			Access-Control-Allow-Origin "https://openwook.cloud"
			Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
			Access-Control-Allow-Credentials "true"
			Access-Control-Max-Age "86400"
		}

		@options method OPTIONS
		handle @options {
			respond "" 204
		}

		import openwook_next_upstreams
	}

	@immutable_static {
		path /_next/static/*
	}

	handle @immutable_static {
		import openwook_next_upstreams
		header Cache-Control "public, max-age=31536000, immutable"
	}

	@public_static {
		path /images/* /fonts/* /favicon.ico /robots.txt /sitemap.xml
	}

	handle @public_static {
		root * {$OPENWOOK_ROOT}/public
		file_server
		header Cache-Control "public, max-age=86400"
	}

	handle {
		import openwook_next_upstreams
	}
}

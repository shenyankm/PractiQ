[Unit]
Description=OpenWook Next.js Application
Documentation=https://nextjs.org/docs/app/building-your-application/deploying
After=network.target network-online.target
Requires=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/openwook
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=PATH=/home/ubuntu/.nvm/versions/node/v24.16.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/home/ubuntu/projects/openwook/.env.local
ExecStart=/usr/bin/env pnpm start:prod
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/projects/openwook /tmp

[Install]
WantedBy=multi-user.target

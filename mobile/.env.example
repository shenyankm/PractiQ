# Android Emulator: http://10.0.2.2:8080
# iOS Simulator: http://127.0.0.1:8080
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080
# Google OAuth client IDs (leave unset to hide the Google sign-in button).
# The web client ID must also be listed in the backend GOOGLE_MOBILE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_REVERSED_CLIENT_ID=

# RevenueCat public platform SDK keys. Real purchases require an Expo native
# development/store build; Expo Go only previews the integration.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

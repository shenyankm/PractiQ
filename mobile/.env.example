# Android Emulator: http://10.0.2.2:8080
# iOS Simulator / web: http://127.0.0.1:8080
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080
# Google OAuth client IDs (leave unset to hide the Google sign-in button).
# The web client ID must also be listed in the backend GOOGLE_MOBILE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

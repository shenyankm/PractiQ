{
  "name": "practiq-desktop",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "cd .. && node app/node_modules/eslint/bin/eslint.js --config app/eslint.config.mjs \"app/src/**/*.{ts,tsx}\" shared/*.tsx \"shared/cloud/**/*.{ts,tsx}\" --max-warnings 0",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "node desktop/build.ts",
    "contracts:check": "node scripts/export-contracts.ts --check",
    "desktop:electron": "npm run build && npm run desktop:build && electron .build/electron/app/desktop/main.js",
    "test:desktop": "npm run desktop:build && vitest run --config desktop/vitest.config.ts",
    "test:electron": "npm run build && npm run desktop:build && node scripts/electron-smoke.ts",
    "test:electron:installed": "node scripts/electron-smoke.ts --installed",
    "check:ui": "tsc -b && npm run lint && npm run test:coverage",
    "check": "tsc -b && npm run lint && vitest run && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo test --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:browser": "playwright test",
    "test:preview": "playwright test --project preview",
    "test:rich-content": "playwright test --project rich-content",
    "package:electron": "node scripts/package-electron.ts",
    "verify:existing-data": "node scripts/verify-existing-data.ts",
    "test:package": "node scripts/verify-electron-package.ts",
    "check:packaging": "tsc -p scripts/tsconfig.packaging.json"
  },
  "dependencies": {
    "@hyzyla/pdfium": "3.0.0",
    "@langchain/langgraph": "1.7.4",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "@tauri-apps/api": "^2.12.4",
    "ajv": "8.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "katex": "0.19.1",
    "lucide-react": "^1.70.0",
    "lzma-purejs": "0.9.3",
    "parse-entities": "4.0.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "saxes": "6.0.0",
    "seek-bzip": "2.0.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/parser": "^7.29.9",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "45.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "$katex"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PractiQ",
  "version": "0.1.0",
  "identifier": "com.practiq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PractiQ",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Education",
    "shortDescription": "离线题库与练习",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "bundled/": "bundled/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}

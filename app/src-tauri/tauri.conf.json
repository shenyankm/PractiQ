{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PractiQ",
  "version": "0.1.0",
  "identifier": "com.practiq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PractiQ",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Education",
    "shortDescription": "离线题库与练习",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundled/python/": "bundled/python/",
      "bundled/build-manifest.json": "bundled/build-manifest.json",
      "bundled/THIRD-PARTY.txt": "bundled/THIRD-PARTY.txt",
      "bundled/PYTHON-LICENSE.txt": "bundled/PYTHON-LICENSE.txt"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "files": {
        "Resources/bundled/office": "bundled/office"
      }
    }
  }
}

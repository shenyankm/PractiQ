{
  "AudioReference": {
    "additionalProperties": false,
    "properties": {
      "objectKey": {
        "maxLength": 1024,
        "minLength": 1,
        "title": "Objectkey",
        "type": "string"
      },
      "sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Sha256",
        "type": "string"
      },
      "mediaType": {
        "pattern": "^audio/(mpeg|mp4|aac|wav)$",
        "title": "Mediatype",
        "type": "string"
      },
      "sizeBytes": {
        "exclusiveMinimum": 0,
        "maximum": 26214400,
        "title": "Sizebytes",
        "type": "integer"
      }
    },
    "required": [
      "objectKey",
      "sha256",
      "mediaType",
      "sizeBytes"
    ],
    "title": "AudioReference",
    "type": "object"
  },
  "ChoiceAnswerPayload": {
    "additionalProperties": false,

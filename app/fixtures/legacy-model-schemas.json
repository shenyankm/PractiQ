        "type": "string"
      },
      "instructions": {
        "anyOf": [
          {
            "maxLength": 20000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Instructions"
      },
      "questionIndexes": {
        "description": "Zero-based positions in this fragment's questions, not printed question numbers.",
        "items": {
          "type": "integer"
        },
        "maxItems": 1000,
        "title": "Questionindexes",
        "type": "array"
      }
    },
    "required": [
      "title",
      "questionIndexes"
    ],
    "title": "ParsedGroup",
    "type": "object"
  },
  "ParsedItem": {
    "additionalProperties": false,

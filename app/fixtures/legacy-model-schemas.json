      "examPlayCount": {
        "default": 2,
        "maximum": 100,
        "minimum": 1,
        "title": "Examplaycount",
        "type": "integer"
      },
      "sourceLanguage": {
        "anyOf": [
          {
            "maxLength": 64,
            "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Sourcelanguage"
      },
      "targetLanguage": {
        "anyOf": [
          {
            "maxLength": 64,
            "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Targetlanguage"
      },
      "writingGenre": {
        "anyOf": [
          {
            "maxLength": 128,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Writinggenre"
      },
      "minWords": {
        "anyOf": [
          {
            "maximum": 100000,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Minwords"
      },
      "maxWords": {
        "anyOf": [
          {
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Maxwords"
      },
      "optionSourceId": {
        "anyOf": [
          {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Optionsourceid"
      },
      "passage": {
        "items": {
          "$ref": "#/$defs/ContentBlock"
        },
        "maxItems": 1000,
        "title": "Passage",
        "type": "array"
      },
      "allowReuse": {
        "default": false,
        "title": "Allowreuse",
        "type": "boolean"
      },
      "blankCount": {
        "anyOf": [
          {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Blankcount"
      },
      "stem": {
        "anyOf": [
          {
            "maxLength": 120000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Stem"
      },
      "answerMode": {
        "anyOf": [
          {
            "enum": [
              "choice",
              "true_false",
              "fill_blank",
              "short_answer",
              "ordering",
              "matching",
              "reading",
              "word_bank",
              "cloze",
              "listening",
              "gap_fill"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Answermode"
      },
      "questionTypeId": {
        "anyOf": [
          {
            "maxLength": 128,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Questiontypeid"
      },
      "choiceVariant": {
        "anyOf": [
          {
            "enum": [
              "single",
              "multiple"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Choicevariant"
      },
      "matchingVariant": {
        "anyOf": [
          {
            "enum": [
              "one_to_one",
              "many_to_one"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Matchingvariant"
      },
      "items": {
        "items": {
          "$ref": "#/$defs/ParsedItem"
        },
        "maxItems": 100,
        "title": "Items",
        "type": "array"
      },
      "options": {
        "items": {
          "$ref": "#/$defs/ParsedOption"
        },
        "maxItems": 100,
        "title": "Options",
        "type": "array"
      },
      "answerPayload": {
        "anyOf": [
          {
            "$ref": "#/$defs/ChoiceAnswerPayload"
          },
          {
            "$ref": "#/$defs/TrueFalseAnswerPayload"
          },
          {
            "$ref": "#/$defs/FillBlankAnswerPayload"
          },
          {
            "$ref": "#/$defs/ShortAnswerPayload"
          },
          {
            "$ref": "#/$defs/OrderingAnswerPayload"
          },
          {
            "$ref": "#/$defs/MatchingAnswerPayload"
          },
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Extract only an answer explicitly supplied by the source; never solve the question. Use null when absent.",
        "title": "Answerpayload"
      },
      "sourceScore": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "maximum": 1000000,
            "multipleOf": 0.01,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Sourcescore"
      },
      "scoringRubric": {
        "anyOf": [
          {
            "maxLength": 100000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Scoringrubric"
      },
      "scoreSourceText": {
        "anyOf": [
          {
            "maxLength": 100000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Scoresourcetext"
      },
      "analysis": {
        "anyOf": [
          {
            "maxLength": 100000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Analysis"
      },
      "contentBlocks": {
        "items": {
          "$ref": "#/$defs/ContentBlock"
        },
        "maxItems": 1000,
        "title": "Contentblocks",
        "type": "array"
      },
      "sourceText": {
        "anyOf": [
          {
            "maxLength": 120000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Literal source text for locating this question; do not summarize or paraphrase.",
        "title": "Sourcetext"
      },
      "confidence": {
        "default": 0,
        "description": "Reliability of extraction, not confidence that the answer is correct.",
        "maximum": 1,
        "minimum": 0,
        "title": "Confidence",
        "type": "number"
      },
      "needsReview": {
        "default": true,
        "description": "True when extraction is uncertain; missing fields also force review during validation.",
        "title": "Needsreview",
        "type": "boolean"
      },
      "missingFields": {
        "items": {
          "enum": [
            "stem",
            "questionTypeId",
            "answerMode",
            "choiceVariant",
            "matchingVariant",
            "options",
            "items",
            "answerPayload",
            "analysis",
            "sourceText",
            "media",
            "material"
          ],
          "type": "string"
        },
        "title": "Missingfields",
        "type": "array"
      }
    },
    "title": "ParsedQuestion",
    "type": "object"
  },

  "PageFigure": {
    "properties": {
      "role": {
        "anyOf": [
          {
            "maxLength": 64,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Use answer if any part contains supplied answers, solutions, analysis or scoring rubrics; otherwise material.",
        "title": "Role"
      },
      "questionIndexes": {
        "description": "Indexes in this response questions array; empty only for genuinely unassociated figures.",
        "items": {
          "type": "integer"
        },
        "maxItems": 1000,
        "title": "Questionindexes",
        "type": "array"
      },
      "kind": {
        "default": "image",
        "description": "Classify visible content: table for rows/columns, chart for plotted data, diagram for schematic relationships, qr_code for QR codes, image for other pictures.",
        "enum": [
          "image",
          "table",
          "chart",
          "diagram",
          "qr_code"
        ],
        "title": "Kind",
        "type": "string"
      },
      "tableRows": {
        "anyOf": [
          {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "maxItems": 1000,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Simple table only: first row is headers, then ALL data rows, each cell a raw string with inline $LaTeX$. Equal column counts; empty cells remain empty strings. Null for merged/multilevel tables that cannot be faithfully represented.",
        "title": "Tablerows"
      },
      "extractedText": {
        "anyOf": [
          {
            "maxLength": 100000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "For tables: complete GFM Markdown table including headers and every cell; for merged/multilevel cells use faithful readable text without inventing a flattened table. For other figures: visible text or null.",
        "title": "Extractedtext"
      },
      "label": {
        "anyOf": [
          {
            "maxLength": 1000,
            "type": "string"
          },
          {
            "type": "null"

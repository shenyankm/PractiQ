        "default": null,
        "title": "Questionid"
      },
      "role": {
        "anyOf": [
          {
            "maxLength": 64,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Role"
      },
      "textValue": {
        "anyOf": [
          {
            "maxLength": 120000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Textvalue"
      },
      "markdownValue": {
        "anyOf": [
          {
            "maxLength": 100000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Markdownvalue"
      },
      "latexValue": {
        "anyOf": [
          {
            "maxLength": 20000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Latexvalue"
      },
      "jsonValue": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Jsonvalue"
      }
    },
    "required": [
      "partType"
    ],
    "title": "ContentBlock",
    "type": "object"
  },
  "FillBlankAnswerPayload": {

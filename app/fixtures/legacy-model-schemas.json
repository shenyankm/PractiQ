            "type": "null"
          }
        ],
        "default": null,
        "title": "Parentid"
      },
      "questionKind": {
        "anyOf": [
          {
            "enum": [
              "listening",
              "reading",
              "word_bank",
              "cloze",
              "grammar_fill",
              "sentence_selection",
              "paragraph_matching",
              "translation",
              "writing"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Questionkind"
      },
      "instructions": {
        "anyOf": [
          {
            "maxLength": 20000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Instructions"
      },
      "audioRef": {
        "anyOf": [
          {
            "$ref": "#/$defs/AudioReference"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "audioStartSeconds": {
        "default": 0,
        "maximum": 86400,
        "minimum": 0,
        "title": "Audiostartseconds",
        "type": "number"
      },
      "audioEndSeconds": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "maximum": 86400,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Audioendseconds"
      },

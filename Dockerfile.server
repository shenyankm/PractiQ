FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim@sha256:7cf77f594be8042dab6daa9fe326f90962252268b4f120a7f5dccce4d947e6c1 AS lock
WORKDIR /lock
COPY server/pyproject.toml server/uv.lock ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o requirements.txt

FROM python:3.14-slim-bookworm@sha256:bf5a06313080f516be80f78839d992270e7877dde4e2c345a41b84f862fbc28b
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends libreoffice-writer libreoffice-calc fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
COPY --from=lock /usr/local/bin/uv /usr/local/bin/uv
COPY --from=lock /lock/requirements.txt /tmp/requirements.txt
RUN uv pip install --system --no-cache-dir -r /tmp/requirements.txt
COPY server/pyproject.toml server/uv.lock /app/server/
COPY server/src /app/server/src
WORKDIR /app/server
RUN uv pip install --system --no-cache-dir --no-deps .
ENV LANGSMITH_TRACING=false LANGCHAIN_TRACING_V2=false
EXPOSE 8000
# Host networking keeps the service on loopback behind the host HTTPS proxy.
CMD ["python", "-m", "uvicorn", "practiq_ai.webapp:app", "--host", "127.0.0.1", "--port", "8000", "--workers", "1", "--timeout-graceful-shutdown", "65"]

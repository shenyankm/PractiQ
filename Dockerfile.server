FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim@sha256:7cf77f594be8042dab6daa9fe326f90962252268b4f120a7f5dccce4d947e6c1 AS lock
WORKDIR /lock
COPY server/pyproject.toml server/uv.lock ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o requirements.txt
RUN python -c "import tomllib; project = tomllib.load(open('pyproject.toml', 'rb')); print(*project['build-system']['requires'] + project['tool']['uv']['build-constraint-dependencies'], sep='\n', file=open('build-constraints.txt', 'w'))"

FROM rust:1.99.1-slim-bookworm@sha256:86234e857a413004348b471d11a4ebe1aa92d2eae2b6b143cac68fd1ac3c48be AS rust-toolchain

FROM python:3.15-bookworm@sha256:6f060cab421d9509c6c6a6a7762c651baf03c3f1d0145befe16b688762b7fe81 AS dependencies
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup PATH=/usr/local/cargo/bin:$PATH
COPY --from=lock /usr/local/bin/uv /usr/local/bin/uv
COPY --from=lock /lock/requirements.txt /tmp/requirements.txt
COPY --from=lock /lock/build-constraints.txt /tmp/build-constraints.txt
RUN UV_HTTP_TIMEOUT=120 uv pip install --prefix /opt/runtime --no-cache-dir --build-constraints /tmp/build-constraints.txt -r /tmp/requirements.txt

FROM python:3.15-slim-bookworm@sha256:96599df822d0e1c6bb700014a05c7f3c8cabc6e0f7ff3c4f9f69cee033b4b5d9
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends fonts-noto-cjk libreoffice-writer libreoffice-calc libreoffice-impress libyaml-0-2 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=lock /usr/local/bin/uv /usr/local/bin/uv
COPY --from=lock /lock/build-constraints.txt /tmp/build-constraints.txt
COPY --from=dependencies /opt/runtime /usr/local
COPY server/pyproject.toml server/uv.lock server/build_backend.py /app/server/
COPY LICENSE /app/LICENSE
COPY server/src /app/server/src
COPY server/licenses /app/server/licenses
# The personal Web workspace contains no accounts or administrator interface.
COPY web/dist /app/web/dist
WORKDIR /app/server
RUN UV_HTTP_TIMEOUT=120 uv pip install --system --no-cache-dir --no-deps --build-constraints /tmp/build-constraints.txt .
RUN groupadd --gid 10001 practiq && useradd --uid 10001 --gid 10001 --create-home practiq \
    && mkdir -p /var/lib/practiq && chown 10001:10001 /var/lib/practiq
ENV LANGSMITH_TRACING=false LANGCHAIN_TRACING_V2=false AI_STORAGE_DIR=/var/lib/practiq/files AI_WEB_DIR=/app/web/dist
# Office is a service deployment dependency. Enable it only by configuring an
# explicit absolute AI_OFFICE_EXECUTABLE and its exact AI_OFFICE_VERSION.
USER 10001:10001
EXPOSE 8000
# Host networking keeps the service on loopback behind the host HTTPS proxy.
CMD ["python", "-m", "uvicorn", "practiq_ai.webapp:app", "--host", "127.0.0.1", "--port", "8000", "--workers", "1", "--timeout-graceful-shutdown", "65"]

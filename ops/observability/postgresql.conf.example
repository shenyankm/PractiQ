# Example PostgreSQL observability settings. Apply through your managed
# database parameter group or postgresql.conf, then restart PostgreSQL if
# shared_preload_libraries changes.

shared_preload_libraries = 'pg_stat_statements'
pg_stat_statements.track = all
track_io_timing = on
log_min_duration_statement = '500ms'
log_lock_waits = on
deadlock_timeout = '1s'

+                    let selected = exact(&weights, target).unwrap();
+                    assert!(selected.windows(2).all(|pair| pair[0] < pair[1]));
+                    assert!(selected
+                        .iter()
+                        .all(|&i| i < weights.len() && weights[i] > 0));
+                    assert_eq!(selected.iter().map(|&i| weights[i]).sum::<usize>(), target);

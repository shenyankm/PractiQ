  "childProgram": "import time\nstarted=time.perf_counter()\nimport asyncio, json, resource, statistics, sys\nfrom dataclasses import replace\nfrom pathlib import Path\nfrom practiq_ai.config import load\nfrom practiq_ai.contracts import DocumentReference\nfrom practiq_ai.storage import ObjectStore\nimports=(time.perf_counter()-started)*1000\nstore=ObjectStore(replace(load(),storage_dir=Path(sys.argv[1])))\nref=DocumentReference.model_validate_json(sys.argv[2])\nasync def run():\n    values=[]\n    for index in range(26):\n        t=time.perf_counter(); payload=await store.get_verified(ref); elapsed=(time.perf_counter()-t)*1000\n        assert len(payload)==ref.sizeBytes\n        values.append(elapsed)\n    return values\ntry:\n    values=asyncio.run(run())\nfinally:\n    store._executor.shutdown()\nprint(json.dumps({'importsMs':imports,'firstVerifiedReadMs':values[0],'warmSamplesMs':values[1:],\n  'warmMedianMs':statistics.median(values[1:]),'maxRssBytes':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}))\n",
